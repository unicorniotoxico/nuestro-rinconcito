# Configuración de ejemplo. Copiá este archivo como .env (o cargá estas
# variables en tu hosting). NO subas tu .env con claves reales a GitHub.

# Puerto y dirección donde escucha el servidor
PORT=3000
HOST=0.0.0.0

# Dónde se guardan las islas
#   file     → archivos JSON en DATA_DIR (servidor propio, PC, Docker con volumen)
#   supabase → tabla de Supabase (para hostings gratis sin disco, como Render free)
STORAGE=file
DATA_DIR=./data

# Solo si STORAGE=supabase (la "service_role key" es secreta: nunca la pongas en el navegador)
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_SERVICE_KEY=pegá-acá-tu-service-role-key
SUPABASE_TABLE=islands

# Detrás de un proxy (Render, Cloudflare, Caddy, Nginx) poné 1 para ver la IP real
TRUST_PROXY=0

# Orígenes permitidos para el WebSocket, separados por coma. Vacío = el mismo
# dominio desde el que se abre la página (lo normal).
ALLOWED_ORIGINS=

# Límites anti-abuso (por IP)
MAX_ISLANDS=500
CREATE_PER_HOUR=6
JOIN_TRIES_PER_10MIN=20
